#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "[qatool] error: unable to determine repository root" >&2
  exit 1
}

if ! command -v qatool >/dev/null 2>&1; then
  echo "[qatool] error: qatool command not found; install the package first" >&2
  exit 1
fi

diff_file=$(mktemp "${TMPDIR:-/tmp}/qatool-post-commit.XXXXXX")
cleanup() {
  rm -f "$diff_file"
}
trap cleanup EXIT INT TERM

parents=$(git -C "$repo_root" show -s --format=%P HEAD)
if [ -n "$parents" ]; then
  base=$(git -C "$repo_root" merge-base --octopus $parents)
else
  base=$(git -C "$repo_root" hash-object -t tree /dev/null)
fi

git -C "$repo_root" diff --name-status -M "$base" HEAD >"$diff_file"

if [ ! -s "$diff_file" ]; then
  exit 0
fi

qatool reindex --repo "$repo_root" --changed-files "$diff_file"
